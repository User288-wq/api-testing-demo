{
  "info": {
    "name": "API Test Suite - User288-wq",
    "description": "Tests CRUD complets avec assertions avancées",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET - Liste des posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Réponse est un tableau', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('Au moins 10 posts', () => pm.expect(pm.response.json().length).to.be.at.least(10));",
              "const posts = pm.response.json();",
              "pm.environment.set('firstPostId', posts[0].id);",
              "console.log('First post ID:', posts[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/posts"
      }
    },
    {
      "name": "2. GET - Un post par ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const post = pm.response.json();",
              "pm.test('Contient les champs id, title, body, userId', () => {",
              "  pm.expect(post).to.have.all.keys('userId', 'id', 'title', 'body');",
              "});",
              "pm.test('ID est un nombre', () => pm.expect(post.id).to.be.a('number'));",
              "pm.test('Title non vide', () => pm.expect(post.title).to.not.be.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/posts/1"
      }
    },
    {
      "name": "3. POST - Créer un post",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueTitle = `Post Test ${Date.now()}`;",
              "pm.variables.set('dynamicTitle', uniqueTitle);",
              "const body = {",
              "  title: uniqueTitle,",
              "  body: 'Contenu généré automatiquement',",
              "  userId: 1",
              "};",
              "pm.request.body.raw = JSON.stringify(body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const response = pm.response.json();",
              "pm.test('ID créé', () => pm.expect(response).to.have.property('id'));",
              "pm.test('Title correspond', () => pm.expect(response.title).to.eql(pm.variables.get('dynamicTitle')));",
              "pm.environment.set('createdPostId', response.id);",
              "console.log('Post créé avec ID:', response.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{BASE_URL}}/posts"
      }
    },
    {
      "name": "4. PUT - Mettre à jour un post (ID fixe 1)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const updatedTitle = `Updated ${Date.now()}`;",
              "pm.variables.set('updatedTitle', updatedTitle);",
              "const updatedBody = {",
              "  id: 1,",
              "  title: updatedTitle,",
              "  body: 'Contenu modifié',",
              "  userId: 1",
              "};",
              "pm.request.body.raw = JSON.stringify(updatedBody);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const updated = pm.response.json();",
              "pm.test('Title mis à jour', () => pm.expect(updated.title).to.eql(pm.variables.get('updatedTitle')));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{BASE_URL}}/posts/1"
      }
    },
    {
      "name": "5. DELETE - Supprimer un post (ID créé)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "console.log('Post supprimé avec succès');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{BASE_URL}}/posts/{{createdPostId}}"
      }
    },
    {
      "name": "6. Test 404 sur ressource inexistante",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/posts/999999"
      }
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.request.headers.add({ key: \"Authorization\", value: \"Basic \" + pm.environment.get(\"BASIC_AUTH\") });"
        ],
        "type": "text/javascript"
      }
    }
  ]
}
